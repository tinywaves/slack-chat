{
  "name": "@dhzh/http-server",
  "type": "module",
  "version": "1.0.1",
  "description": "A TypeScript implement of http-server",
  "packageManager": "pnpm@11.23.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "download"
    }
  },
  "author": {
    "name": "tinywaves",
    "email": "dhzhme@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/tinywaves/http-server",
  "keywords": [
    "typescript",
    "http-server"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "htttp-server": "./bin/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "url": "git+https://github.com/tinywaves/http-server",
    "type": "git"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "build:dev": "tsdown --watch",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:cli": "tsx watch --clear-screen=false src/cli.ts",
    "lint": "eslint",
    "lint-fix": "eslint --fix .",
    "prepare": "husky",
    "release": "bumpp",
    "release:publish": "pnpm release && pnpm publish --access public",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage",
    "test:dev": "vitest",
    "version:update": "taze major",
    "version:update:w": "taze major -w"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ejs": "^6.0.1",
    "mime": "^4.1.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@dhzh/eslint-config": "^2.4.4",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "bumpp": "^12.2.1",
    "changelogithub": "^15.0.4",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "taze": "^21.1.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
